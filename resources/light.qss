* { font-family: "Segoe UI", "Microsoft YaHei UI"; font-size: 13px; }
QWidget { color: #202938; background: transparent; }
QMainWindow, QDialog, QWidget#appRoot, QWidget#settingsBody, QWidget#captureBody { background: #f5f7fb; }
QScrollArea { background: transparent; border: 0; }
QScrollArea > QWidget > QWidget { background: transparent; }
QFrame#sidebar, QWidget#sidebar, QGroupBox, QTabWidget::pane { background: #ffffff; border: 1px solid #dbe2ee; border-radius: 8px; }
QGroupBox { margin-top: 14px; padding: 12px 8px 8px 8px; font-weight: 600; }
QGroupBox::title { subcontrol-origin: margin; left: 12px; padding: 0 5px; color: #4b5567; background: #ffffff; }
QLabel, QCheckBox, QRadioButton { color: #202938; background: transparent; }
QLabel#contentTitle { color: #172033; background: transparent; font-size: 20px; font-weight: 700; }
QLabel#secondaryText { color: #64748b; background: transparent; }
QLineEdit, QPlainTextEdit, QTextEdit, QComboBox, QSpinBox { color: #202938; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 5px; padding: 6px; selection-background-color: #2563eb; selection-color: white; }
QComboBox QAbstractItemView { color: #202938; background: #ffffff; border: 1px solid #cbd5e1; selection-background-color: #dbeafe; selection-color: #172033; outline: 0; }
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QComboBox:focus, QSpinBox:focus { border-color: #3b82f6; }
QPushButton { color: #202938; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 5px; padding: 7px 12px; }
QPushButton:hover { background: #eff6ff; border-color: #60a5fa; }
QPushButton:pressed { background: #dbeafe; }
QPushButton:disabled { color: #94a3b8; background: #f1f5f9; border-color: #e2e8f0; }
QPushButton#primaryButton { background: #2563eb; border-color: #2563eb; color: white; font-weight: 600; }
QPushButton#dangerButton { background: #fee2e2; border-color: #ef4444; color: #991b1b; }
QHeaderView::section { background: #eef2f7; color: #475569; padding: 7px; border: 0; border-right: 1px solid #dbe2ee; border-bottom: 1px solid #dbe2ee; }
QTableWidget { color: #202938; background: #ffffff; alternate-background-color: #f8fafc; border: 1px solid #dbe2ee; gridline-color: #e2e8f0; selection-background-color: #dbeafe; selection-color: #172033; }
QTabBar::tab { color: #475569; background: #eef2f7; padding: 9px 15px; border-bottom: 2px solid transparent; }
QTabBar::tab:selected { color: #1d4ed8; border-bottom-color: #3b82f6; }
QScrollBar:vertical { background: #f1f5f9; width: 11px; }
QScrollBar::handle:vertical { background: #cbd5e1; border-radius: 5px; min-height: 30px; }
QToolTip { background: #ffffff; color: #202938; border: 1px solid #cbd5e1; }
QLabel#metricValue { background: transparent; font-size: 21px; font-weight: 700; color: #172033; }
QLabel#metricTitle { background: transparent; color: #64748b; }
QLabel#statusPass { background: transparent; color: #059669; font-weight: 700; font-size: 16px; }
QLabel#statusFail { background: transparent; color: #dc2626; font-weight: 700; font-size: 16px; }
QStatusBar { color: #334155; background: #eef2f7; border-top: 1px solid #dbe2ee; }
QWidget#titleBar { background: #ffffff; border-bottom: 1px solid #dbe2ee; }
QLabel#appMark { background: #2563eb; color: white; border-radius: 7px; font-weight: 800; }
QLabel#windowTitleLabel { background: transparent; color: #172033; font-size: 15px; font-weight: 700; }
QPushButton#titleBarButton, QPushButton#titleBarClose { background: transparent; color: #334155; border: 0; border-radius: 4px; padding: 5px 10px; font-size: 15px; }
QPushButton#titleBarButton:hover { background: #eff6ff; }
QPushButton#titleBarClose:hover { color: white; background: #dc2626; }
QLabel#featureBadge { color: #1d4ed8; background: #dbeafe; padding: 6px 10px; border-radius: 10px; }
QLabel#sessionSummary { color: #64748b; background: transparent; padding: 6px; }
QProgressBar { color: #334155; background: #ffffff; border: 1px solid #cbd5e1; border-radius: 5px; text-align: center; }
QProgressBar::chunk { background: #2563eb; border-radius: 4px; }

QLabel#captureHint { color: #475569; background: #eef2f7; border: 1px solid #dbe2ee; border-radius: 6px; padding: 8px 10px; }
QLabel#captureDetailTitle { color: #475569; background: transparent; padding: 2px 0; }
QTableWidget#captureTable { min-height: 180px; }
